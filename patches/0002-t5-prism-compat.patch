+void apply_prism_t5_compat(Bindings& bindings, const Config& config) {
+    const auto* prism = config.text.prism_hadamard ? &*config.text.prism_hadamard : nullptr;
+    std::unordered_map<std::uint64_t, WeightId> sign_ids;
+    if (prism) {
+        for (const auto& [width, name] : prism->signs) {
+            sign_ids.emplace(width, bindings.direct(name, {width}, QType::BF16));
+        }
+        for (PendingWeight& weight : bindings.weights) {
+            const std::string_view name = weight.reference.name;
+            std::string_view role;
+            if (name == "text/output_head") {
+                role = "output_head";
+            } else if (name.starts_with("text/layers/")) {
+                const auto after_prefix = name.substr(std::string_view("text/layers/").size());
+                const auto slash        = after_prefix.find('/');
+                if (slash != std::string_view::npos) { role = after_prefix.substr(slash + 1); }
+            }
+            if (role.empty() || !prism->rotated_inputs.contains(std::string(role))) { continue; }
+            if (weight.reference.shape.size() != 2) {
+                throw artifact::ArtifactError(weight.reference.name +
+                                              ": prism_hadamard projection must be a matrix");
+            }
+            const auto found = sign_ids.find(weight.reference.shape[1]);
+            if (found == sign_ids.end()) {
+                throw artifact::ArtifactError(weight.reference.name +
+                                              ": missing prism_hadamard sign vector for width " +
+                                              std::to_string(weight.reference.shape[1]));
+            }
+            for (WeightUse& use : weight.uses) {
+                if (!use.hadamard_signs) {
+                    use.hadamard_signs = found->second;
+                    use.hadamard_begin = 0;
+                }
+            }
+        }
+    }
+    for (const PendingWeight& weight : bindings.weights) {
+        bool has_t5 = false;
+        for (const auto& part : weight.reference.binding.parts) {
+            if (bindings.binder.geometry(part.object).format != QType::T5_G128_FP16) { continue; }
+            has_t5 = true;
+            if (weight.reference.residency != artifact::Residency::Device) {
+                throw std::invalid_argument(
+                    "--embedding-residency host is not supported with t5_g128_fp16 artifacts; "
+                    "use default device residency");
+            }
+            bindings.binder.transcode_device(part.object, QType::T2_G128_FP16);
+        }
+        if (has_t5 && weight.reference.name == "text/token_embedding" &&
+            (!prism || !prism->embedding_inverse)) {
+            throw artifact::ArtifactError(
+                "t5_g128_fp16 token_embedding requires prism_hadamard.embedding_inverse=true");
+        }
+    }
+}
