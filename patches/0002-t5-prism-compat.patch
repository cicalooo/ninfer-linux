+void transcode_t5(DeviceContext& device) {
+    constexpr std::uint64_t kRows = 4;
+    constexpr std::uint64_t kCols = 256;
+    const auto src_geo = weight_geometry(QType::T5_G128_FP16, QuantLayout::TernaryRowK128,
+                                         std::array<std::uint64_t, 2>{kRows, kCols});
+    const auto dst_geo = weight_geometry(QType::T2_G128_FP16, QuantLayout::RowSplit,
+                                         std::array<std::uint64_t, 2>{kRows, kCols});
+
+    std::vector<std::byte> t5_payload(static_cast<std::size_t>(src_geo.bytes), std::byte{0});
+    std::vector<std::byte> expected_t2(static_cast<std::size_t>(dst_geo.bytes), std::byte{0});
+    static constexpr std::array<std::uint8_t, 3> kTritToT2{3U, 0U, 1U};
+
+    for (std::uint64_t row = 0; row < kRows; ++row) {
+        for (std::uint64_t unit = 0; unit < kCols / 64; ++unit) {
+            std::array<std::uint8_t, 65> trits{};
+            for (std::uint64_t col = 0; col < 64; ++col) {
+                const std::uint64_t global_col = unit * 64 + col;
+                trits[col] = static_cast<std::uint8_t>((row * 5 + global_col * 3 + unit) % 3);
+            }
+            trits[64] = 0;
+            const std::size_t src_off =
+                static_cast<std::size_t>(row * src_geo.code_bytes_per_row + unit * 13);
+            for (int i = 0; i < 12; ++i) {
+                const int g = i / 4;
+                const int j = i % 4;
+                int val     = 0;
+                for (int m = 0; m < 5; ++m) { val = val * 3 + trits[20 * g + 4 * m + j]; }
+                t5_payload[src_off + i] = static_cast<std::byte>((256 * val + 242) / 243);
+            }
+            {
+                int val = 0;
+                for (int m = 0; m < 5; ++m) { val = val * 3 + trits[60 + m]; }
+                t5_payload[src_off + 12] = static_cast<std::byte>((256 * val + 242) / 243);
+            }
+            const std::size_t dst_off =
+                static_cast<std::size_t>(row * dst_geo.code_bytes_per_row + unit * 16);
+            for (int b = 0; b < 16; ++b) {
+                expected_t2[dst_off + b] = static_cast<std::byte>(
+                    kTritToT2[trits[4 * b]] | (kTritToT2[trits[4 * b + 1]] << 2U) |
+                    (kTritToT2[trits[4 * b + 2]] << 4U) | (kTritToT2[trits[4 * b + 3]] << 6U));
+            }
+        }
+        for (std::uint64_t g = 0; g < kCols / 128; ++g) {
+            const std::uint16_t scale = static_cast<std::uint16_t>(0x3800U + row * 0x0100U + g);
+            put_word(t5_payload, static_cast<std::size_t>(src_geo.scale_offset + row * 4 + g * 2),
+                     scale, 2);
+            put_word(expected_t2, static_cast<std::size_t>(dst_geo.scale_offset + row * 4 + g * 2),
+                     scale, 2);
+        }
+    }
+
+    std::vector<std::byte> transcoded(static_cast<std::size_t>(dst_geo.bytes));
+    transcode_device_payload(QType::T5_G128_FP16, QuantLayout::TernaryRowK128, QType::T2_G128_FP16,
+                             std::array<std::uint64_t, 2>{kRows, kCols}, t5_payload, transcoded);
+    require(transcoded == expected_t2, "T5 -> T2 transcode bytes differ from expected layout");
+
+    {
+        auto bad = t5_payload;
+        bad[0]   = std::byte{1}; // non-canonical base-3 byte (val=0->0, val=1->2)
+        rejects(
+            [&] {
+                transcode_device_payload(QType::T5_G128_FP16, QuantLayout::TernaryRowK128,
+                                         QType::T2_G128_FP16,
+                                         std::array<std::uint64_t, 2>{kRows, kCols}, bad,
+                                         transcoded);
+            },
+            "non-canonical base-3 byte was accepted");
+    }
+    {
+        auto bad = t5_payload;
+        bad[12]  = std::byte{255}; // canonical byte for val=242, whose 5th trit is 2 != 0
+        rejects(
+            [&] {
+                transcode_device_payload(QType::T5_G128_FP16, QuantLayout::TernaryRowK128,
+                                         QType::T2_G128_FP16,
+                                         std::array<std::uint64_t, 2>{kRows, kCols}, bad,
+                                         transcoded);
+            },
+            "nonzero padding trit in byte 12 was accepted");
+    }
+
+    // End-to-end artifact materialization of a T5_G128_FP16 object transcoded to T2_G128_FP16.
+    Fixture fixture;
+    fixture.payload = t5_payload;
+    fixture.root    = {
+        {"components", {{"text", {{"config", Json::object()}}}}},
+        {"objects", Json::array({{{"id", "t5"},
+                                  {"kind", "tensor"},
+                                  {"shape", {kRows, kCols}},
+                                  {"format", "t5_g128_fp16"},
+                                  {"layout", "ternary_row_k128_v1"},
+                                  {"offset", 0},
+                                  {"bytes", src_geo.bytes}}})},
+        {"bindings", {{"w", {{"object", "t5"}}}}},
+        {"uses", Json::array()},
+        {"files", Json::array({{{"path", nullptr}, {"payload_bytes", src_geo.bytes}}})}};
+    fixture.write(false);
+
+    Reader reader(fixture.entry);
+    Binder binder(reader);
+    const auto w_ref = binder.parameter("w", {kRows, kCols});
+    binder.transcode_device(reader.find("t5"), QType::T2_G128_FP16);
+    auto backing     = materialize(reader, std::move(binder).finish(), device);
+    const auto view  = bind_view(w_ref, backing);
+    const auto w     = native_weight(view);
+    require(w.qtype == QType::T2_G128_FP16 && w.layout == QuantLayout::RowSplit,
+            "transcoded device parent did not expose T2_G128_FP16 RowSplit");
+    std::vector<std::byte> uploaded(static_cast<std::size_t>(dst_geo.bytes));
+    CUDA_CHECK(cudaMemcpy(uploaded.data(), w.payload, uploaded.size(), cudaMemcpyDeviceToHost));
+    require(uploaded == expected_t2, "materialized T5 -> T2 GPU bytes differ from expected");
+}
