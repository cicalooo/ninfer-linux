diff --git a/src/artifact/transcode.cpp b/src/artifact/transcode.cpp
index 2f840167..47c2b380 100644
--- a/src/artifact/transcode.cpp
+++ b/src/artifact/transcode.cpp
@@ -210,6 +210,147 @@ bool row_split_transcode_supported(QType source, QType target) noexcept {
            (target == QType::Q4_G64_FP16 || target == QType::Q6_G64_FP16);
 }
 
+bool device_transcode_supported(QType source, QuantLayout source_layout, QType target) noexcept {
+    if (source_layout == QuantLayout::RowSplit && row_split_transcode_supported(source, target)) {
+        return true;
+    }
+    return source == QType::T5_G128_FP16 && source_layout == QuantLayout::TernaryRowK128 &&
+           target == QType::T2_G128_FP16;
+}
+
+namespace {
+
+void transcode_t5_rows(const WeightGeometry& source_geometry, const WeightGeometry& target_geometry,
+                       std::span<const std::byte> source, std::span<std::byte> destination,
+                       std::uint64_t row_begin, std::uint64_t row_end) {
+    // 0 -> -1 (0b11 = 3), 1 -> 0 (0b00 = 0), 2 -> +1 (0b01 = 1)
+    static constexpr std::array<std::uint8_t, 3> kTritToT2{3U, 0U, 1U};
+    const std::uint64_t units = source_geometry.shape[1] / 64;
+    const std::byte* const src_codes = source.data();
+    std::byte* const dst_codes       = destination.data();
+
+    for (std::uint64_t row = row_begin; row < row_end; ++row) {
+        const std::byte* src_unit = src_codes + row * source_geometry.code_bytes_per_row;
+        std::byte* dst_unit       = dst_codes + row * target_geometry.code_bytes_per_row;
+        for (std::uint64_t unit = 0; unit < units; ++unit, src_unit += 13, dst_unit += 16) {
+            std::array<std::uint8_t, 64> trits{};
+            for (int i = 0; i < 12; ++i) {
+                const int orig = std::to_integer<int>(src_unit[i]);
+                int rem        = orig;
+                const int g    = i / 4;
+                const int j    = i % 4;
+                int val        = 0;
+                for (int m = 0; m < 5; ++m) {
+                    rem *= 3;
+                    const int t = rem >> 8;
+                    rem &= 255;
+                    if (t < 0 || t > 2) {
+                        throw ArtifactError("t5_g128_fp16 trit out of range");
+                    }
+                    trits[20 * g + 4 * m + j] = static_cast<std::uint8_t>(t);
+                    val                       = val * 3 + t;
+                }
+                if (((256 * val + 242) / 243) != orig) {
+                    throw ArtifactError("t5_g128_fp16 contains non-canonical base-3 byte");
+                }
+            }
+            {
+                const int orig = std::to_integer<int>(src_unit[12]);
+                int rem        = orig;
+                int val        = 0;
+                for (int m = 0; m < 5; ++m) {
+                    rem *= 3;
+                    const int t = rem >> 8;
+                    rem &= 255;
+                    if (t < 0 || t > 2) {
+                        throw ArtifactError("t5_g128_fp16 trit out of range");
+                    }
+                    if (m < 4) {
+                        trits[60 + m] = static_cast<std::uint8_t>(t);
+                    } else if (t != 0) {
+                        throw ArtifactError("t5_g128_fp16 byte 12 must have zero fifth trit");
+                    }
+                    val = val * 3 + t;
+                }
+                if (((256 * val + 242) / 243) != orig) {
+                    throw ArtifactError("t5_g128_fp16 contains non-canonical base-3 byte");
+                }
+            }
+            for (int b = 0; b < 16; ++b) {
+                const std::uint8_t packed = static_cast<std::uint8_t>(
+                    kTritToT2[trits[4 * b]] | (kTritToT2[trits[4 * b + 1]] << 2U) |
+                    (kTritToT2[trits[4 * b + 2]] << 4U) | (kTritToT2[trits[4 * b + 3]] << 6U));
+                dst_unit[b] = static_cast<std::byte>(packed);
+            }
+        }
+    }
+}
+
+void transcode_t5_to_t2(std::span<const std::uint64_t> shape, std::span<const std::byte> source,
+                        std::span<std::byte> destination) {
+    const WeightGeometry source_geometry =
+        weight_geometry(QType::T5_G128_FP16, QuantLayout::TernaryRowK128, shape);
+    const WeightGeometry target_geometry =
+        weight_geometry(QType::T2_G128_FP16, QuantLayout::RowSplit, shape);
+    if (source.size() != source_geometry.bytes || destination.size() != target_geometry.bytes ||
+        source_geometry.scale_bytes != target_geometry.scale_bytes) {
+        throw ArtifactError("t5_g128_fp16 transcode payload sizes do not match the tensor shape");
+    }
+    std::fill(destination.begin(), destination.end(), std::byte{0});
+
+    const std::uint64_t rows = shape[0];
+    const std::uint64_t workers = std::clamp<std::uint64_t>(
+        std::thread::hardware_concurrency(), 1, std::max<std::uint64_t>(rows, 1));
+    if (workers == 1) {
+        transcode_t5_rows(source_geometry, target_geometry, source, destination, 0, rows);
+    } else {
+        std::vector<std::thread> pool;
+        pool.reserve(static_cast<std::size_t>(workers - 1));
+        std::vector<std::exception_ptr> failures(static_cast<std::size_t>(workers));
+        for (std::uint64_t worker = 1; worker < workers; ++worker) {
+            pool.emplace_back([&, worker] {
+                try {
+                    transcode_t5_rows(source_geometry, target_geometry, source, destination,
+                                      rows * worker / workers, rows * (worker + 1) / workers);
+                } catch (...) {
+                    failures[static_cast<std::size_t>(worker)] = std::current_exception();
+                }
+            });
+        }
+        try {
+            transcode_t5_rows(source_geometry, target_geometry, source, destination, 0,
+                              rows / workers);
+        } catch (...) {
+            failures[0] = std::current_exception();
+        }
+        for (std::thread& thread : pool) { thread.join(); }
+        for (const std::exception_ptr& failure : failures) {
+            if (failure) { std::rethrow_exception(failure); }
+        }
+    }
+    std::memcpy(destination.data() + target_geometry.scale_offset,
+                source.data() + source_geometry.scale_offset, target_geometry.scale_bytes);
+}
+
+} // namespace
+
+void transcode_device_payload(QType source_format, QuantLayout source_layout, QType target,
+                              std::span<const std::uint64_t> shape,
+                              std::span<const std::byte> source,
+                              std::span<std::byte> destination) {
+    if (source_format == QType::T5_G128_FP16 && source_layout == QuantLayout::TernaryRowK128 &&
+        target == QType::T2_G128_FP16) {
+        transcode_t5_to_t2(shape, source, destination);
+        return;
+    }
+    if (source_layout == QuantLayout::RowSplit &&
+        row_split_transcode_supported(source_format, target)) {
+        transcode_row_split(target, shape, source, destination);
+        return;
+    }
+    throw ArtifactError("unsupported device payload transcode");
+}
+
 void transcode_row_split(QType target, std::span<const std::uint64_t> shape,
                          std::span<const std::byte> source, std::span<std::byte> destination) {
     const TargetCodec codec = target_codec(target);
